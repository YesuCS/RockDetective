<template>
    <div class="rd-stepper-select mb-3">
        <select class="form-control" :value="String(currentPhase)" @change="onSelectChange">
            <option v-for="definition in definitions" :key="definition.phase"
                    :value="String(definition.phase)"
                    :disabled="isPhaseDisabled(definition.phase) || isUnused(definition)">
                {{ progressOf(definition.phase) === 2 ? "✓ " : "" }}{{ definition.phase }}. {{ definition.name }}{{ isUnused(definition) ? " (not used in Simple)" : "" }}
            </option>
        </select>
    </div>

    <div class="rd-stepper d-flex flex-wrap align-items-end mb-3" style="gap: 8px 28px;">
        <div v-for="stage in stages" :key="stage.key">
            <div class="text-muted mb-1" style="font-size: 12px;" :title="stage.hint">
                <i v-if="stage.isLoop" class="ti ti-refresh mr-1"></i>{{ stage.label }}
            </div>
            <div class="d-flex align-items-center" style="gap: 4px;">
                <button v-for="definition in stage.definitions"
                        :key="definition.phase"
                        type="button"
                        class="btn btn-xs"
                        :class="buttonClass(definition.phase)"
                        :style="isUnused(definition) ? 'opacity: 0.45; border-style: dashed;' : ''"
                        :title="chipTitle(definition)"
                        :disabled="isPhaseDisabled(definition.phase) || isUnused(definition)"
                        @click="$emit('phaseSelected', definition.phase)">
                    <i v-if="isUnused(definition)" class="ti ti-minus mr-1"></i>
                    <i v-else-if="progressOf(definition.phase) === 2 && definition.phase !== currentPhase" class="ti ti-check mr-1"></i>
                    <i v-else-if="isPhaseDisabled(definition.phase)" class="ti ti-lock mr-1"></i>
                    <i v-else-if="progressOf(definition.phase) === 3" class="ti ti-arrow-forward mr-1"></i>
                    {{ definition.phase }}<template v-if="definition.phase === currentPhase">. {{ definition.name }}</template>
                </button>
            </div>
        </div>
    </div>
</template>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import type { PhaseDefinitionBag, PhaseStateBag } from "../types.partial";

    const props = defineProps({
        definitions: {
            type: Array as PropType<PhaseDefinitionBag[]>,
            required: true
        },
        phaseStates: {
            type: Array as PropType<PhaseStateBag[]>,
            required: true
        },
        currentPhase: {
            type: Number,
            required: true
        },
        furthestPhase: {
            type: Number,
            default: 9
        },
        isSimpleMode: {
            type: Boolean,
            default: false
        },
        isJumpRestricted: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "phaseSelected", phase: number): void;
    }>();

    function onSelectChange(event: Event): void {
        const phase = Number((event.target as HTMLSelectElement).value);

        if (phase && phase !== props.currentPhase) {
            emit("phaseSelected", phase);
        }
    }

    function isUnused(definition: PhaseDefinitionBag): boolean {
        if (!props.isSimpleMode || !definition.isAutoSkippedInSimpleMode || definition.phase === props.currentPhase) {
            return false;
        }

        const progress = progressOf(definition.phase);

        return progress !== 1 && progress !== 2;
    }

    type Stage = { key: string; label: string; hint: string; isLoop: boolean; definitions: PhaseDefinitionBag[] };

    const stages = computed<Stage[]>(() => {
        const loopNames = props.definitions.filter(d => d.isLoopPhase).map(d => d.name).join(", ");

        const all: Stage[] = [
            { key: "setup", label: "Set up", hint: "Get the team, the problem, and the timeline straight before investigating.", isLoop: false, definitions: props.definitions.filter(d => d.phase < 5) },
            { key: "investigate", label: "Investigate", hint: `These phases loop: keep cycling through ${loopNames} until a cause is confirmed beyond a reasonable doubt.`, isLoop: true, definitions: props.definitions.filter(d => d.phase >= 5 && d.phase <= 8) },
            { key: "close", label: "Close", hint: "Write up what happened and how to prevent it.", isLoop: false, definitions: props.definitions.filter(d => d.phase > 8) }
        ];

        return all.filter(s => s.definitions.length > 0);
    });

    function chipTitle(definition: PhaseDefinitionBag): string {
        if (isUnused(definition)) {
            return `${definition.phase}. ${definition.name}: not used in Simple mode. Upgrade to Advanced to work this phase.`;
        }

        if (isPhaseDisabled(definition.phase)) {
            return `${definition.phase}. ${definition.name}: locked until the phases before it are complete.`;
        }

        return `${definition.phase}. ${definition.name}: ${definition.guidance}`;
    }

    function progressOf(phase: number): number {
        return props.phaseStates.find(s => s.phase === phase)?.progress ?? 0;
    }

    function isPhaseDisabled(phase: number): boolean {
        return props.isJumpRestricted && phase !== props.currentPhase && phase > props.furthestPhase;
    }

    function buttonClass(phase: number): string {
        if (phase === props.currentPhase) {
            return "btn-primary";
        }
        if (progressOf(phase) === 2) {
            return "btn-success";
        }
        return "btn-default";
    }
</script>
