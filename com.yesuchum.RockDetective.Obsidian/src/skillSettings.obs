<template>
    <NotificationBox v-if="!config.canEdit" alertType="warning">
        Skill settings are only available to people with Administrate access to this block.
    </NotificationBox>

    <Panel v-else title="Skill Settings" type="block">
        <p class="text-muted">
            The Rock Detective skill is a regular Rock AI skill, so you can change it to fit how your church works.
            Each tool below is a short piece of Lava you can edit in Rock's AI Skills screen: its name, its description,
            its parameters, and the Lava itself. You can also add tools of your own or delete ones you do not want.
            A standard tool you delete stays deleted until you add it back here.
        </p>

        <NotificationBox alertType="info">
            Editing a tool changes what the assistant is told and what it sends. It does not change what is allowed.
            The checklists, case security, and who may use which tool are enforced by Rock Detective every time a tool runs.
        </NotificationBox>

        <NotificationBox v-if="message" :alertType="messageType" :dismissible="true" @dismiss="message = ''">{{ message }}</NotificationBox>

        <div class="d-flex mb-3" style="gap: 8px;">
            <a v-if="config.skillUrl" :href="config.skillUrl" class="btn btn-primary">Edit the Skill in Rock</a>
            <RockButton :btnType="BtnType.Default" :disabled="isWorking" @click="onRestoreAll">Restore Everything to Standard</RockButton>
        </div>

        <NotificationBox v-if="!config.skillUrl" alertType="warning">
            The link to Rock's AI Skills screen could not be worked out. Look for AI Skills under Admin Tools, then open Rock Detective.
        </NotificationBox>

        <p v-if="status.addedToolCount > 0" class="text-muted">
            This skill also has {{ status.addedToolCount }} {{ status.addedToolCount === 1 ? "tool" : "tools" }} you added yourself.
            Restoring never touches those.
        </p>

        <table class="table table-condensed">
            <thead>
                <tr>
                    <th>Tool</th>
                    <th>What it does</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="tool in status.tools" :key="tool.guid">
                    <td>
                        {{ tool.name }}
                        <div v-if="tool.name !== tool.standardName" class="text-muted small">Standard name: {{ tool.standardName }}</div>
                    </td>
                    <td class="small">{{ tool.description }}</td>
                    <td><span :class="labelClass(tool.state)">{{ tool.state }}</span></td>
                    <td class="text-right">
                        <RockButton v-if="tool.state !== 'Standard'"
                                    :btnType="BtnType.Default"
                                    :btnSize="BtnSize.ExtraSmall"
                                    :disabled="isWorking"
                                    @click="onRestore(tool)">
                            {{ tool.state === "Missing" ? "Add Back" : "Restore" }}
                        </RockButton>
                    </td>
                </tr>
            </tbody>
        </table>
    </Panel>
</template>

<script setup lang="ts">
    import { ref } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { confirm } from "@Obsidian/Utility/dialogs";
    import type { SkillSettingsInitBag, SkillStatusBag, SkillToolStatusBag } from "./types.partial";

    const config = useConfigurationValues<SkillSettingsInitBag>();
    const invokeBlockAction = useInvokeBlockAction();

    const isWorking = ref(false);
    const message = ref("");
    const messageType = ref<string>(AlertType.Success);
    const status = ref<SkillStatusBag>(config.status ?? { tools: [], addedToolCount: 0 });

    function labelClass(state: string): string {
        if (state === "Standard") {
            return "label label-success";
        }

        return state === "Missing" ? "label label-danger" : "label label-warning";
    }

    async function run(action: string, data: Record<string, unknown>, successMessage: string): Promise<void> {
        isWorking.value = true;

        try {
            const result = await invokeBlockAction<SkillStatusBag>(action, data);

            if (result.isSuccess && result.data) {
                status.value = result.data;
                message.value = successMessage;
                messageType.value = AlertType.Success;
            }
            else {
                message.value = result.errorMessage ?? "That did not work.";
                messageType.value = AlertType.Danger;
            }
        }
        finally {
            isWorking.value = false;
        }
    }

    async function onRestore(tool: SkillToolStatusBag): Promise<void> {
        const question = tool.state === "Missing"
            ? `Add the standard ${tool.standardName} tool back to the skill?`
            : `Put ${tool.name} back to its standard name, description, parameters, and Lava? Your edits to it will be lost.`;

        if (await confirm(question)) {
            await run("RestoreTool", { toolGuid: tool.guid }, `${tool.standardName} is back to standard.`);
        }
    }

    async function onRestoreAll(): Promise<void> {
        const confirmed = await confirm("Put the skill and every standard tool back the way Rock Detective ships them? Your edits to them will be lost. Tools you added yourself are left alone.");

        if (confirmed) {
            await run("RestoreAll", {}, "The skill and its standard tools are back to standard.");
        }
    }
</script>
