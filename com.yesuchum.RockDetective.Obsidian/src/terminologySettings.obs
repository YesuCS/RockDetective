<template>
    <NotificationBox v-if="!config.canEdit" alertType="warning">
        Terminology settings are only available to people with Administrate access to this block.
    </NotificationBox>

    <Panel v-else title="Terminology Settings" type="block">
        <p class="text-muted">
            Rename the phases, terms and gate wording so Rock Detective speaks your ministry's language.
            Anything you leave blank keeps its standard wording, shown in gray.
        </p>

        <DropDownList v-model="scope" label="Applies To" :items="scopeItems" :showBlankItem="false"
                      help="Pick one case category to give it its own wording, or set the wording for every category at once. A category's own wording wins over the wording for all categories." />

        <NotificationBox v-if="message" :alertType="messageType" :dismissible="true" @dismiss="message = ''">{{ message }}</NotificationBox>

        <template v-if="!isLoading">
            <h4 class="mt-4">Terms</h4>
            <p class="text-muted">The words used for people and items throughout the case board, the PDF report and the MCP tools. Enter one of each; Rock works out the plural for you.</p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th style="width: 30%;">Standard Term</th><th>New Term</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="term in config.terms" :key="term.key">
                            <td>{{ term.label }}</td>
                            <td><input v-model="termValues[term.key]" type="text" class="form-control" maxlength="60" :placeholder="term.defaultSingular" :disabled="!config.canEdit" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h4 class="mt-4">Phases</h4>
            <p class="text-muted">
                The name of each step, the guidance shown under it, and the prompts people work through. Enter one prompt per line.
            </p>
            <NotificationBox alertType="info">
                Guidance, prompts and gate wording can include your terms so they update automatically.
                Write <code>{champion}</code> for the term in lower case, <code>{Champion}</code> to capitalize it,
                <code>{fact+}</code> for more than one, <code>{fact#}</code> to match a count, and <code>{count}</code> for the required number.
            </NotificationBox>
            <div v-for="phase in config.phases" :key="phase.key" class="mb-3 p-3" style="border: 1px solid var(--color-interface-softer, #eee); border-radius: 4px;">
                <div class="row">
                    <div class="col-md-4">
                        <label class="control-label">{{ phase.phase }}. Name</label>
                        <input v-model="phaseValues[phase.key].name" type="text" class="form-control" maxlength="60" :placeholder="phase.defaultName" :disabled="!config.canEdit" />
                    </div>
                    <div class="col-md-8">
                        <label class="control-label">Guidance</label>
                        <textarea v-model="phaseValues[phase.key].guidance" class="form-control" rows="2" :placeholder="phase.defaultGuidance" :disabled="!config.canEdit"></textarea>
                    </div>
                </div>
                <div class="mt-2">
                    <label class="control-label">Prompts</label>
                    <textarea v-model="phaseValues[phase.key].promptsText" class="form-control" rows="3" :placeholder="phase.defaultPrompts.join('\n')" :disabled="!config.canEdit"></textarea>
                </div>
            </div>

            <h4 class="mt-4">Gate Wording</h4>
            <p class="text-muted">The checklist sentences that must be met before a phase can be completed. This changes the wording only; what each gate checks stays the same.</p>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th style="width: 22%;">Phase</th><th>Checklist Sentence</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="gate in config.gates" :key="gate.key">
                            <td>{{ gate.phaseName }}</td>
                            <td><input v-model="gateValues[gate.key]" type="text" class="form-control" :placeholder="gate.defaultDescription" :disabled="!config.canEdit" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div v-if="config.canEdit" class="d-flex mt-3" style="gap: 8px;">
                <RockButton :btnType="BtnType.Primary" :disabled="isSaving" @click="onSave">{{ isSaving ? "Saving..." : "Save" }}</RockButton>
                <RockButton :btnType="BtnType.Default" :disabled="isSaving" @click="onReset">Reset to Standard Wording</RockButton>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
    import { ref, reactive, computed, watch } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { AlertType } from "@Obsidian/Enums/Controls/alertType";
    import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block";
    import { confirm } from "@Obsidian/Utility/dialogs";
    import type { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import type { TerminologySettingsInitBag, TerminologyValuesBag } from "./types.partial";


    type PhaseValue = { name: string; guidance: string; promptsText: string };

    const config = useConfigurationValues<TerminologySettingsInitBag>();
    const invokeBlockAction = useInvokeBlockAction();

    const allCategoriesValue = "all";

    const scope = ref(allCategoriesValue);
    const isLoading = ref(true);
    const isSaving = ref(false);
    const message = ref("");
    const messageType = ref<string>(AlertType.Success);

    const termValues = reactive<Record<string, string>>({});
    const phaseValues = reactive<Record<string, PhaseValue>>({});
    const gateValues = reactive<Record<string, string>>({});

    const scopeItems = computed<ListItemBag[]>(() => [
        { value: allCategoriesValue, text: "All categories" },
        ...(config.categories ?? []).map(c => ({ value: c.guid, text: c.name }))
    ]);

    function findValue<T>(source: Record<string, T> | null | undefined, key: string): T | undefined {
        if (!source) {
            return undefined;
        }

        const match = Object.keys(source).find(k => k.toLowerCase() === key.toLowerCase());

        return match ? source[match] : undefined;
    }

    function applyValues(values: TerminologyValuesBag | null): void {
        for (const term of config.terms) {
            termValues[term.key] = findValue(values?.terms, term.key) ?? "";
        }

        for (const phase of config.phases) {
            const saved = findValue(values?.phases, phase.key);
            phaseValues[phase.key] = {
                name: saved?.name ?? "",
                guidance: saved?.guidance ?? "",
                promptsText: (saved?.prompts ?? []).join("\n")
            };
        }

        for (const gate of config.gates) {
            gateValues[gate.key] = findValue(values?.gateDescriptions, gate.key) ?? "";
        }
    }

    function categoryGuidForScope(): string {
        return scope.value === allCategoriesValue ? "" : scope.value;
    }

    async function load(): Promise<void> {
        isLoading.value = true;
        applyValues(null);

        const result = await invokeBlockAction<TerminologyValuesBag>("GetTerminology", { categoryGuid: categoryGuidForScope() });

        if (result.isSuccess && result.data) {
            applyValues(result.data);
        }
        else {
            message.value = result.errorMessage ?? "The wording could not be loaded.";
            messageType.value = AlertType.Danger;
        }

        isLoading.value = false;
    }

    function buildBag(): TerminologyValuesBag {
        const bag: TerminologyValuesBag = { terms: {}, phases: {}, gateDescriptions: {} };

        for (const term of config.terms) {
            bag.terms[term.key] = termValues[term.key];
        }

        for (const phase of config.phases) {
            const value = phaseValues[phase.key];
            bag.phases[phase.key] = {
                name: value.name,
                guidance: value.guidance,
                prompts: value.promptsText.split("\n").map(p => p.trim()).filter(p => p.length > 0)
            };
        }

        for (const gate of config.gates) {
            bag.gateDescriptions[gate.key] = gateValues[gate.key];
        }

        return bag;
    }

    async function save(bag: TerminologyValuesBag, successMessage: string): Promise<void> {
        isSaving.value = true;

        try {
            const result = await invokeBlockAction("SaveTerminology", { categoryGuid: categoryGuidForScope(), bag });

            if (result.isSuccess) {
                message.value = successMessage;
                messageType.value = AlertType.Success;
                await load();
            }
            else {
                message.value = result.errorMessage ?? "The wording could not be saved.";
                messageType.value = AlertType.Danger;
            }
        }
        finally {
            isSaving.value = false;
        }
    }

    function onSave(): void {
        save(buildBag(), "Wording saved. Open cases pick it up the next time they load.");
    }

    async function onReset(): Promise<void> {
        const confirmed = await confirm("Clear every custom name here and go back to the standard wording?");

        if (confirmed) {
            await save({ terms: {}, phases: {}, gateDescriptions: {} }, "Standard wording restored.");
        }
    }

    watch(scope, () => {
        message.value = "";
        load();
    });

    if (config.canEdit) {
        applyValues(null);
        load();
    }
</script>
